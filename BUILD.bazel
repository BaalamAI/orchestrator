load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/baalamai/orchestrator

go_library(
    name = "orchestrator",
    srcs = [
        "budget.go",
        "builder.go",
        "checkpoint.go",
        "config.go",
        "doc.go",
        "domain.go",
        "errors.go",
        "hooks.go",
        "loop.go",
        "metrics.go",
        "orchestrator.go",
        "parallel.go",
        "ports.go",
        "retry.go",
        "run.go",
        "snapshot.go",
    ],
    importpath = "github.com/baalamai/orchestrator",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/orchestrator/obs",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
